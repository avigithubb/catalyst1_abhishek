# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Server Config
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Database Connection (PostgreSQL)
DATABASE_URL=postgres://postgres:your_postgres_password_here@localhost:5432/elderly_care_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=elderly_care_db
DB_SSL=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Email Alerts / SMTP Notification Service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=demo_user
SMTP_PASS=demo_pass
EMAIL_FROM="Elderly Care Alerts <alerts@elderlycare.local>"
EMERGENCY_ESCALATION_EMAIL=family_emergency_board@elderlycare.local

# OAuth Provider Settings
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Gemini API Configuration
GEMINI_API_URL=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
